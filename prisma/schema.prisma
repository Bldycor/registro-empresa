// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ADMIN tiene control total de la aplicación (incluye todo lo que ve/hace un Coordinador) y es
// el único rol que puede crear cuentas de Coordinador — un Coordinador ya NO se autoregistra
// públicamente (riesgo de seguridad: cualquiera, incluido un aprendiz, podía crear una cuenta de
// coordinador). No hay autoregistro público de ADMIN tampoco; el primer administrador se
// promueve directamente en la base de datos.
enum Role {
  APRENDIZ
  INSTRUCTOR
  COORDINADOR
  ADMIN
}

enum EstadoAprendiz {
  ACTIVO
  // El aprendiz interrumpió (renunció, lo liquidaron, se trasladó, etc.) el tramo de Etapa
  // Productiva que venía ejecutando y todavía no tiene avalada una alternativa nueva para
  // retomarla. El tiempo ya cumplido queda acumulado en `diasEjecutadosPrevios` y se descuenta
  // del tramo siguiente — ver `InterrupcionEtapaProductiva` y la guía GFPI-G-040 §7 y §9.3.
  PRACTICA_INTERRUMPIDA
  // Novedad que SUSPENDE la práctica sin terminarla: licencia de maternidad, incapacidad,
  // vacaciones colectivas, cese de actividad de la empresa o fuerza mayor (guía GFPI-G-040 §9.3).
  // A diferencia de PRACTICA_INTERRUMPIDA, el aprendiz vuelve con la MISMA alternativa, así que
  // no necesita un GFPI-F-165 nuevo: al reanudar se le abre otro tramo por el tiempo que le
  // faltaba. Lo aprueba el Comité de Evaluación y Seguimiento — ver `AplazamientoEtapaProductiva`.
  APLAZADA
  // El instructor lo marca así uno a uno (ver checklist de Seguimiento), solo cuando las 6
  // evidencias de Etapa Productiva ya quedaron avaladas/aprobadas — dispara el correo con la
  // ficha de requisitos institucionales de certificación. Coordinación lo revisa y hace el paso
  // final a CERTIFICADO.
  POR_CERTIFICAR
  CERTIFICADO
  // Declaración institucional de que el aprendiz abandonó el proceso (guía GFPI-G-040 §9.1.1):
  // no presentó la planeación antes de la fecha fin de su grupo, o interrumpió la práctica y no
  // consiguió alternativa nueva avalada dentro del período de ejecución. El sistema NUNCA lo
  // declara solo: señala el riesgo (ver src/lib/desercion.ts) y Coordinación decide, porque es
  // un acto administrativo con consecuencias para el aprendiz.
  DESERTADO
}

// Modalidad ("alternativa") bajo la cual el aprendiz cursa su Etapa Productiva. Se elige/edita
// mediante la evidencia "Selección/Modificación de Alternativa" (formato GFPI-F-165), no al
// registrarse — ver `SeleccionAlternativaEP`.
enum AlternativaEtapaProductiva {
  CONTRATO_APRENDIZAJE
  CONTRATO_VINCULO_FORMATIVO
  MONITORIA
  PROYECTO_PRODUCTIVO
  VINCULO_LABORAL
}

// Subtipos oficiales de cada alternativa, según el formato GFPI-F-165. La pertenencia de un
// subtipo a su alternativa se valida en `src/lib/validations.ts` (Zod), no aquí — Prisma no
// modela enums anidados.
enum SubtipoAlternativaEtapaProductiva {
  CONTRATO_APRENDIZAJE_REGULAR
  CONTRATO_APRENDIZAJE_ECONOMIA_POPULAR_CAMPESINA
  CONTRATO_APRENDIZAJE_GRUPO_INVESTIGACION
  VINCULO_FORMATIVO_ASESORIA_PYMES
  VINCULO_FORMATIVO_APOYO_UNIDAD_PRODUCTIVA_FAMILIAR
  VINCULO_FORMATIVO_APOYO_INSTITUCION_ESTATAL_ONG
  VINCULO_FORMATIVO_GRUPO_INVESTIGACION
  VINCULO_FORMATIVO_ECONOMIA_POPULAR_CAMPESINA
  MONITORIA_REGULAR
  MONITORIA_GRUPO_INVESTIGACION
  PROYECTO_SENA_EMPRESA
  PROYECTO_SENA_PROVEEDOR_SENA
  PROYECTO_PRODUCCION_CENTROS
  PROYECTO_ENFOQUE_EMPRESARIAL
  PROYECTO_ENFOQUE_IDI
  PROYECTO_RUTA_EMPRENDEDORA
  PROYECTO_ECONOMIA_POPULAR_CAMPESINA
  VINCULO_LABORAL_REGULAR
  VINCULO_LABORAL_ECONOMIA_POPULAR_CAMPESINA
}

// Tipo de solicitud del formato GFPI-F-165: la primera vez que un aprendiz declara su
// alternativa es SELECCION; cualquier cambio posterior es MODIFICACION.
enum TipoSolicitudAlternativa {
  SELECCION
  MODIFICACION
}

// Tipo de documento de identidad, según las opciones reales de los formatos institucionales.
enum TipoDocumento {
  CC
  TI
  NUIP
  CE
  PEP
  OTRO
}

// Modalidad del programa de formación (distinta de `Jornada`, que es el horario). Aplica a nivel
// de ficha/grupo, igual que en los formatos GFPI-F-165 y GFPI-F-023.
enum ModalidadFormacion {
  PRESENCIAL
  VIRTUAL
  A_DISTANCIA
}

// Modalidad de ejecución de la Etapa Productiva del aprendiz (independiente de la modalidad de
// formación) — puede variar por aprendiz aunque compartan ficha.
enum ModalidadEjecucionEP {
  PRESENCIAL
  VIRTUAL
}

// Nivel de riesgo de afiliación a la ARL (Administradora de Riesgos Laborales), según el
// formato GFPI-F-147.
enum NivelRiesgoARL {
  I
  II
  III
  IV
  V
}

enum TipoDiscapacidad {
  AUDITIVA
  VISUAL
  MOTORA
  COGNITIVA
  MULTIPLE
}

// Las 16 comunas oficiales de Medellín, para el campo de ubicación de residencia
// (reemplaza el antiguo campo de "barrio" en texto libre).
enum Comuna {
  POPULAR
  SANTA_CRUZ
  MANRIQUE
  ARANJUEZ
  CASTILLA
  DOCE_DE_OCTUBRE
  ROBLEDO
  VILLA_HERMOSA
  BUENOS_AIRES
  LA_CANDELARIA
  LAURELES_ESTADIO
  LA_AMERICA
  SAN_JAVIER
  EL_POBLADO
  GUAYABAL
  BELEN
}

// Área/departamento del SENA al que pertenece un Instructor o Coordinador.
enum Coordinacion {
  CONTABILIDAD_FINANZAS
  COMERCIO_VENTAS
  GESTION_ADMINISTRATIVA_DOCUMENTAL
}

// Estado institucional de la ficha (columna "ESTADO" del control de fichas). Son dos hitos
// distintos, no sinónimos:
// - TERMINADA: la ficha ya venció su plazo límite para iniciar Etapa Productiva
//   (columna "Limite para Iniciar EP" / fechaLimiteIniciarEP) sin haberla iniciado.
// - TERMINADA_POR_FECHA: la ficha ya cumplió su fecha de fin de formación
//   (columna "FECHA DE FIN DE FORMACIÓN" / fechaFinFormacion).
enum EstadoFicha {
  EN_EJECUCION
  TERMINADA
  TERMINADA_POR_FECHA
}

enum NivelFormacion {
  TECNICO
  TECNOLOGO
  AUXILIAR
}

enum TipoCompetencia {
  TECNICA
  BASICA_CLAVE
}

enum Jornada {
  MANANA
  TARDE
  NOCHE
  MIXTA
  VIRTUAL
  TARDE_NOCHE
}

// Convención institucional de calificación de evaluaciones (Fase 0, nunca escrita desde ninguna
// UI). Reemplazada en la práctica por la rúbrica real de 13 variables del formato GFPI-F-023
// (ver `EvaluacionVariable`/`ValoracionVariable`/`JuicioEtapaProductiva`) — se deja el enum y el
// campo `calificacion` existentes sin usar, en vez de borrarlos, por si hiciera falta un resumen
// A/D/P calculado más adelante.
enum Calificacion {
  A // Evaluación correcta (aprobada).
  D // Con errores en el diligenciamiento; requiere corrección y reenvío.
  P // Pendiente de subir, por demora en el tiempo de entrega.
}

// Estado de una evidencia frente a su fecha límite y su revisión por instructor/coordinador.
enum EstadoEvidencia {
  PENDIENTE
  SUBIDA_A_TIEMPO
  SUBIDA_CON_ATRASO
  APROBADA
  RECHAZADA
}

// Categoría de cada variable de la rúbrica de evaluación (formato GFPI-F-023).
enum CategoriaVariableEvaluacion {
  TECNICO
  ACTITUDINAL
}

// Las 13 variables fijas de la rúbrica GFPI-F-023 (8 técnicas + 5 actitudinales).
enum VariableEvaluacion {
  APLICACION_CONOCIMIENTO
  MEJORA_CONTINUA
  FORTALECIMIENTO_OCUPACIONAL
  OPORTUNIDAD_CALIDAD
  RESPONSABILIDAD_AMBIENTAL
  ADMINISTRACION_RECURSOS
  SEGURIDAD_SALUD_TRABAJO
  DOCUMENTACION_ETAPA_PRODUCTIVA
  RELACIONES_INTERPERSONALES
  TRABAJO_EQUIPO
  SOLUCION_PROBLEMAS
  CUMPLIMIENTO
  ORGANIZACION
}

enum ValoracionVariable {
  SATISFACTORIO
  POR_MEJORAR
}

// Motivos por los que un aprendiz puede interrumpir el tramo de Etapa Productiva que venía
// ejecutando. Los seis primeros son las causales que la guía GFPI-G-040 §9.3.1 nombra
// explícitamente como justificadas para avalar un cambio de alternativa; los tres siguientes
// son las novedades de §9.3 que suspenden temporalmente la ejecución.
// Novedades que SUSPENDEN temporalmente la Etapa Productiva sin terminarla (guía GFPI-G-040
// §9.3). El aprendiz reanuda con la misma alternativa; lo que cambia son las fechas del plan.
enum MotivoAplazamientoEP {
  LICENCIA_MATERNIDAD
  INCAPACIDAD_MEDICA
  VACACIONES_COLECTIVAS
  CESE_ACTIVIDAD_EMPRESA
  FUERZA_MAYOR
  OTRO
}

enum MotivoInterrupcionEP {
  LIQUIDACION_EMPRESA
  SALUD_CERTIFICADA
  ASUNTOS_JUDICIALES
  SERVICIO_MILITAR
  DESPLAZAMIENTO_GEOGRAFICO
  TERMINACION_ANTICIPADA_CONTRATO
  LICENCIA_MATERNIDAD
  INCAPACIDAD
  FUERZA_MAYOR
  RENUNCIA_VOLUNTARIA
  OTRO
}

// Las 6 variables de la valoración del Momento 1 (Concertación/Planeación) — no forman parte del
// formato GFPI-F-023 (que no valora el Momento 1), pero el instructor las evalúa igual que las
// rúbricas de los Momentos 2/3, con la misma escala (ValoracionVariable).
enum VariablePlaneacionEP {
  COMPETENCIAS_RESULTADOS_DEFINIDOS
  ACTIVIDADES_PLANTEADAS
  EVIDENCIAS_PLANTEADAS
  AFILIACION_ARL
  HORARIO_ACORDADO
  PARTICIPACION_COFORMADOR
}

enum JuicioEtapaProductiva {
  APROBADO
  NO_APROBADO
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String

  nombres             String
  apellidos           String
  cedula              String   @unique
  // Tipo de documento de identidad (CC, TI, NUIP, CE, PEP, Otro). Nullable solo por compatibilidad
  // con cuentas creadas antes de este campo — los formularios nuevos lo exigen.
  tipoDocumento       TipoDocumento?
  celular             String
  direccionResidencia String
  // Necesaria para saber si al iniciar la Etapa Productiva era menor de edad: en ese caso la guía
  // GFPI-G-040 §9.1.1 exige autorización del Ministerio de Trabajo (formato GFPI-F-203) como
  // requisito para el aval. Nullable por compatibilidad con las cuentas ya creadas.
  fechaNacimiento     DateTime?
  // Comuna de Medellín donde reside. Nullable solo por compatibilidad con cuentas creadas antes
  // de este campo; el formulario de registro lo exige siempre para cuentas nuevas.
  comuna              Comuna?
  departamento        String?
  ciudad              String?

  // Rol dentro del sistema. Jerarquía de creación de cuentas (nadie se autoregistra excepto el
  // Aprendiz): ADMIN crea Coordinador (/formulario/admin/coordinadores) → Coordinador crea
  // Instructor (/formulario/coordinador/instructores). El Aprendiz es el único autoregistro
  // público (/register). No hay autoregistro público de Coordinador ni de ADMIN.
  role   Role           @default(APRENDIZ)
  // Estado del aprendiz durante/después de la Etapa Productiva: ACTIVO → POR_CERTIFICAR (lo
  // marca su instructor uno a uno, solo cuando las 6 evidencias ya quedaron avaladas/aprobadas —
  // dispara el correo con la ficha de requisitos de certificación) → CERTIFICADO (paso final,
  // manual, lo hace Coordinación; la certificación de estudio se emite fuera del sistema).
  estado EstadoAprendiz @default(ACTIVO)
  // Trazabilidad de quién marcó a este aprendiz como POR_CERTIFICAR y cuándo (dispara el correo
  // de requisitos). Null mientras no se haya marcado, o si se revierte a ACTIVO por corrección.
  porCertificarPorId String?
  porCertificarPor   User?     @relation("MarcadoPorCertificar", fields: [porCertificarPorId], references: [id], onDelete: SetNull)
  marcadosPorCertificar User[] @relation("MarcadoPorCertificar")
  fechaPorCertificar DateTime?

  // Requisitos de aval de la Etapa Productiva (guía GFPI-G-040 §9.1.1). Los registra Coordinación
  // sobre el aprendiz, no el aprendiz sobre sí mismo — son verificaciones institucionales.
  // `null` significa "sin verificar todavía", distinto de `false` ("verificado y no cumple".)
  rapsEtapaLectivaAprobados Boolean?
  // Autorización del Ministerio de Trabajo (GFPI-F-203) para aprendices menores de edad.
  autorizacionMinTrabajoUrl String?

  // Declaración de deserción (guía GFPI-G-040 §9.1.1). Es un acto administrativo: lo registra
  // Coordinación explícitamente, con la causa que aplicó. El sistema solo señala el riesgo.
  fechaDesercion  DateTime?
  motivoDesercion String?
  declaradoDesertorPorId String?
  declaradoDesertorPor   User?  @relation("DeclaroDesercion", fields: [declaradoDesertorPorId], references: [id], onDelete: SetNull)
  desercionesDeclaradas  User[] @relation("DeclaroDesercion")

  // Fecha real de inicio/fin de la Etapa Productiva de ESTE aprendiz — no todos los aprendices de
  // una misma ficha inician igual ni con la misma alternativa. Se capturan y mantienen
  // sincronizadas exclusivamente desde la evidencia "Selección/Modificación de Alternativa"
  // (`SeleccionAlternativaEP`, formato GFPI-F-165), nunca se editan directamente en otro formulario.
  // Disparan el cálculo de las fechas límite de bitácoras y evaluaciones de este aprendiz.
  fechaInicioEtapaProductiva DateTime?
  fechaFinEtapaProductiva    DateTime?

  // Cuántas bitácoras le corresponden a este aprendiz — 12 (quincenales, 6 meses) es lo estándar,
  // pero una Etapa Productiva más corta (3 meses) solo necesita 6. Lo corrige el instructor
  // individualmente o para toda una ficha (mismo patrón que las fechas de EP) — afecta tanto las
  // fechas límite calculadas (`src/lib/bitacora-fechas.ts`) como las alertas de seguimiento.
  totalBitacoras Int @default(12)

  // Días de Etapa Productiva ya ejecutados y certificados en tramos ANTERIORES (alternativas que
  // el aprendiz interrumpió y no alcanzó a terminar). La guía GFPI-G-040 §9.3.1 exige que ese
  // tiempo se contabilice y se sume a la nueva alternativa: por eso la fecha fin del tramo
  // vigente se calcula como inicio + (180 − diasEjecutadosPrevios), no siempre 180 días.
  // Solo lo acumula el aval de una `InterrupcionEtapaProductiva`, nunca se edita a mano.
  diasEjecutadosPrevios Int @default(0)

  // Número de bitácora con el que arranca el tramo VIGENTE. Al retomar la EP con otra
  // alternativa la numeración continúa (no se reinicia en 1): las bitácoras anteriores a este
  // número ya se entregaron en el tramo previo y conservan sus fechas; de aquí en adelante las
  // fechas límite se recalculan quincenalmente desde la nueva fecha de inicio.
  bitacoraInicioTramo Int @default(1)

  // Modalidad ("alternativa") de Etapa Productiva vigente. Se mantiene sincronizada desde la
  // solicitud de `SeleccionAlternativaEP` más reciente que quede APROBADA (selección o
  // modificación) — no se edita directamente en otro formulario.
  alternativaEtapaProductiva AlternativaEtapaProductiva?
  subtipoAlternativaEtapaProductiva SubtipoAlternativaEtapaProductiva?

  modalidadEjecucionEP ModalidadEjecucionEP?
  realizaEnExterior    Boolean?
  paisEtapaProductiva  String?

  enSituacionDiscapacidad     Boolean?
  tipoDiscapacidad            TipoDiscapacidad?
  nombreAsistenteDiscapacidad String?
  telefonoAsistenteDiscapacidad String?

  // Ficha SENA a la que pertenece (solo aprendices). La ficha debe existir de antemano — la
  // precarga el coordinador académico — y de ahí se deriva quién puede evaluar al aprendiz
  // (Ficha.instructorId), en vez de asignarse directo por aprendiz.
  fichaId String?
  ficha   Ficha?  @relation("FichaAprendices", fields: [fichaId], references: [id])

  // Fichas donde este usuario (rol INSTRUCTOR) está autorizado para evaluar. Un instructor puede
  // tener varias fichas; cada ficha tiene a lo sumo un instructor (ver modelo Ficha).
  fichasAsignadas Ficha[] @relation("InstructorFichas")

  // Área/departamento del SENA. Solo aplica a Instructor y Coordinador (null en Aprendiz).
  coordinacion Coordinacion?

  // Trazabilidad: quién creó esta cuenta (el ADMIN que creó un Coordinador, o el Coordinador que
  // creó un Instructor). Null para el Aprendiz (autoregistro) y para cuentas anteriores a este
  // campo. Si se borra la cuenta creadora, esto queda en null (no se pierde la cuenta creada).
  creadoPorId    String?
  creadoPor      User?   @relation("CuentasCreadas", fields: [creadoPorId], references: [id], onDelete: SetNull)
  cuentasCreadas User[]  @relation("CuentasCreadas")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyProfile          CompanyProfile?
  // Momento 1 (Planeación de la Etapa Productiva = Concertación de funciones). Se mantiene como
  // modelo propio por ser el que ya está construido y en producción; los Momentos 2 y 3 viven en
  // el modelo `Evaluacion`.
  concertacionFuncion     ConcertacionFuncion?
  evaluaciones            Evaluacion[]
  bitacoras               Bitacora[]
  certificacionEmpresario CertificacionEmpresario?
  passwordResetTokens     PasswordResetToken[]

  seleccionesAlternativa      SeleccionAlternativaEP[]      @relation("AprendizSelecciones")
  seleccionesAlternativaAval  SeleccionAlternativaEP[]      @relation("AvalSeleccionAlternativa")
  seleccionesGrupoCreadas     SeleccionAlternativaGrupo[]   @relation("SeleccionesGrupoCreadas")
  formalizacionEtapaProductiva FormalizacionEtapaProductiva? @relation("AprendizFormalizacion")
  formalizacionesAval         FormalizacionEtapaProductiva[] @relation("AvalFormalizacion")
  bitacorasAval               Bitacora[]                    @relation("AvalBitacora")
  evaluacionesAval            Evaluacion[]                  @relation("AvalEvaluacion")
  certificacionesAval         CertificacionEmpresario[]     @relation("AvalCertificacion")
  concertacionesAval          ConcertacionFuncion[]         @relation("AvalConcertacion")
  interrupcionesEP            InterrupcionEtapaProductiva[] @relation("AprendizInterrupciones")
  interrupcionesEPAval        InterrupcionEtapaProductiva[] @relation("AvalInterrupcionEP")
  aplazamientosEP             AplazamientoEtapaProductiva[] @relation("AprendizAplazamientos")
  aplazamientosEPAval         AplazamientoEtapaProductiva[] @relation("AvalAplazamientoEP")
  avisosPlazo                 AvisoPlazo[]                  @relation("AvisosPlazo")
}

// Ficha SENA. La precarga el coordinador académico (carga masiva por código) antes de que los
// aprendices se registren con ella. Cada ficha tiene a lo sumo un instructor autorizado para
// evaluar a sus aprendices (instructorId); puede quedar sin asignar mientras tanto, sin que eso
// bloquee al aprendiz para usar el resto de la aplicación.
model Ficha {
  id       String  @id @default(cuid())
  codigo   String  @unique
  programa String?

  // Datos de gestión institucional de la ficha, migrados desde la hoja de cálculo de control
  // que usaban los instructores (ver docs/PLAN-IMPLEMENTACION.md). Todos nullable porque una
  // ficha puede precargarse solo con su código antes de tener el resto de la información.
  estado         EstadoFicha?
  nivelFormacion NivelFormacion?
  jornada        Jornada?
  // Modalidad de formación del programa (presencial/virtual/a distancia) — concepto distinto de
  // `jornada` (el horario).
  modalidadFormacion ModalidadFormacion?

  // Fecha de inicio de la ficha (apertura académica).
  fechaInicioFicha DateTime?
  // Fecha institucional de referencia de inicio de Etapa Productiva para la ficha en general
  // (se sigue usando para reportes agregados y control institucional), aunque la fecha real que
  // dispara bitácoras/evaluaciones de cada aprendiz es la suya propia — ver `User.fechaInicioEtapaProductiva`.
  fechaInicioProductiva DateTime?
  fechaFinFormacion     DateTime?
  // Fecha límite para que los aprendices de esta ficha inicien su Etapa Productiva. En la hoja
  // de control se calcula como (vigencia del acuerdo 007 o 009, el que aplique) - 180 días; acá
  // se importa el valor ya calculado, sin modelar las columnas de vigencia de acuerdo.
  fechaLimiteIniciarEP DateTime?

  instructorId String?
  instructor   User?   @relation("InstructorFichas", fields: [instructorId], references: [id])

  aprendices User[] @relation("FichaAprendices")
  seleccionesGrupo SeleccionAlternativaGrupo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Catálogo institucional de competencias/resultados de aprendizaje por programa de formación
// (consolidado oficial SENA). Lo administra Coordinador/Admin (importación masiva pegando la
// hoja de cálculo, o carga manual) y alimenta el selector de "Competencias / resultados de
// aprendizaje" en las actividades de Bitácora — evita que el aprendiz lo escriba a mano.
// `resultadoAprendizaje` es el texto que efectivamente se guarda en `BitacoraActividad.competencias`
// (texto libre, sin FK) para no romper compatibilidad con bitácoras ya diligenciadas.
model CompetenciaFormacion {
  id String @id @default(cuid())

  // Debe coincidir con uno de `ProgramasFormacionValues` (mismo catálogo que `Ficha.programa`) —
  // se valida en la capa de aplicación, no en la base de datos.
  programa             String
  tipo                 TipoCompetencia
  codigoCompetencia    String
  nombreCompetencia    String
  resultadoAprendizaje String
  horas                Int?
  redConocimiento      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programa, codigoCompetencia, resultadoAprendizaje])
  @@index([programa])
}

model CompanyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  empresaPatrocinadora String // Empresa patrocinadora
  direccionEmpresa     String // Dirección de la empresa

  nombreCoformador     String // Nombre del coformador
  cargoCoformador      String // Cargo del coformador
  correoCoformador     String // Correo del coformador
  celularCoformador    String // Celular del coformador

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Evidencia (a): Selección/Modificación de Alternativa de Etapa Productiva (formato GFPI-F-165).
// Puede haber varias filas por aprendiz a lo largo del tiempo (una selección inicial y luego
// modificaciones); la más reciente que quede APROBADA es la vigente y es la que sincroniza
// `User.alternativaEtapaProductiva`/`fechaInicioEtapaProductiva`/`fechaFinEtapaProductiva`.
model SeleccionAlternativaEP {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("AprendizSelecciones", fields: [userId], references: [id], onDelete: Cascade)

  tipoSolicitud TipoSolicitudAlternativa
  fechaSolicitud DateTime

  alternativa        AlternativaEtapaProductiva
  subtipoAlternativa SubtipoAlternativaEtapaProductiva?

  // Fechas concertadas de ejecución real de la Etapa Productiva bajo esta alternativa — al
  // aprobarse, sincronizan `User.fechaInicioEtapaProductiva`/`fechaFinEtapaProductiva`.
  fechaInicioEjecucion DateTime?
  fechaFinEjecucion    DateTime?

  // Documento físico GFPI-F-165 diligenciado y firmado, subido como respaldo.
  archivoUrl String?

  estado             EstadoEvidencia @default(PENDIENTE)
  avaladoPorId       String?
  avaladoPor         User?           @relation("AvalSeleccionAlternativa", fields: [avaladoPorId], references: [id], onDelete: SetNull)
  fechaAval          DateTime?
  observacionesAval  String?

  // Constancia de por qué se avaló pese a que algún requisito de §9.1.1 no estaba verificado
  // (RAPs al 100%, ARL vigente un día antes, autorización de MinTrabajo para menores). Los
  // requisitos ADVIERTEN, no bloquean —así lo decidió Coordinación—, pero saltárselos deja
  // registro escrito de quién lo hizo y con qué razón. Ver src/lib/requisitos-aval.ts.
  requisitosOmitidos String?

  // Fecha en que la solicitud avalada quedó registrada en SofiaPlus. La guía §9.1.2 da 8 días
  // hábiles desde el aval; el sistema no se conecta con SofiaPlus, así que esto es la constancia
  // manual de que se hizo — y el punto desde el que se mide si se hizo a tiempo.
  registroSofiaPlus DateTime?

  // Presente solo cuando esta solicitud se envió como parte de un formulario grupal (varios
  // aprendices de la misma ficha con la misma alternativa, en un solo envío).
  grupoId String?
  grupo   SeleccionAlternativaGrupo? @relation(fields: [grupoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Envoltorio de un envío grupal de `SeleccionAlternativaEP` (varios aprendices de una misma
// ficha, con la misma alternativa, diligenciado en conjunto por el instructor/coordinador).
// Interrupción de un tramo de Etapa Productiva (guía GFPI-G-040 §7, §9.3 y §9.3.1). El aprendiz
// reporta que no pudo terminar la EP con la alternativa vigente (renuncia, liquidación de la
// empresa, salud, traslado…), adjuntando el certificado de práctica parcial que expide el ente
// co-formador con el tiempo realmente cumplido. Coordinación lo avala; al avalarlo, esos días se
// suman a `User.diasEjecutadosPrevios` y el aprendiz queda en estado PRACTICA_INTERRUMPIDA hasta
// que se le avale una nueva `SeleccionAlternativaEP` (tipoSolicitud = MODIFICACION), cuyo tramo
// solo cubrirá el tiempo que le falta para completar los 180 días del diseño curricular.
// Aplazamiento de la Etapa Productiva por novedad (guía GFPI-G-040 §9.3): la práctica se
// suspende y se reanuda con la MISMA alternativa, corriendo las fechas del plan.
//
// Mecánica: reutiliza exactamente la del cambio de alternativa (`InterrupcionEtapaProductiva`) —
// el tiempo cumplido hasta la novedad se acumula en `User.diasEjecutadosPrevios` y al reanudar se
// abre otro tramo por el tiempo que falta, continuando la numeración de bitácoras. La diferencia
// es que aquí el aprendiz NO vuelve a diligenciar un GFPI-F-165: la alternativa sigue siendo la
// misma, y quien autoriza es el Comité de Evaluación y Seguimiento, no Coordinación por sí sola.
//
// El Comité es un cuerpo colegiado, no una cuenta del sistema: quien registra el aval es un
// Coordinador/Admin transcribiendo la decisión, y por eso el acta es obligatoria al aprobar.
model AplazamientoEtapaProductiva {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("AprendizAplazamientos", fields: [userId], references: [id], onDelete: Cascade)

  // Alternativa y tramo que se estaban ejecutando cuando apareció la novedad.
  alternativa      AlternativaEtapaProductiva
  fechaInicioTramo DateTime
  // Último día efectivamente trabajado antes de la novedad.
  fechaSuspension  DateTime
  // Cuándo se espera volver. Es una previsión: la fecha real se registra al reanudar.
  fechaReanudacionPrevista DateTime

  // Días cumplidos en el tramo hasta la suspensión — sugeridos por calendario, confirmados por
  // el Comité (mismo criterio que en la interrupción: el soporte manda sobre el calendario).
  diasEjecutados Int

  motivo        MotivoAplazamientoEP
  motivoDetalle String?
  // Soporte de la novedad: licencia, incapacidad de la EPS, comunicación de la empresa, etc.
  soporteUrl    String?

  estado            EstadoEvidencia @default(PENDIENTE)
  avaladoPorId      String?
  avaladoPor        User?           @relation("AvalAplazamientoEP", fields: [avaladoPorId], references: [id], onDelete: SetNull)
  fechaAval         DateTime?
  observacionesAval String?
  // Acta del Comité de Evaluación y Seguimiento que respalda la decisión. Obligatoria al
  // aprobar — sin acta el aplazamiento no tiene soporte institucional.
  actaComite        String?
  fechaActaComite   DateTime?

  // Se llena al registrar la reanudación: desde esta fecha arranca el tramo nuevo.
  fechaReanudacionReal DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model InterrupcionEtapaProductiva {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("AprendizInterrupciones", fields: [userId], references: [id], onDelete: Cascade)

  // Alternativa que se estaba ejecutando cuando se interrumpió, y fechas reales del tramo.
  alternativa       AlternativaEtapaProductiva
  fechaInicioTramo  DateTime
  fechaInterrupcion DateTime

  // Días efectivamente cumplidos en el tramo, según el certificado del ente co-formador. Se
  // sugiere calculado (fechaInterrupcion − fechaInicioTramo) pero lo confirma Coordinación al
  // avalar, porque el certificado manda sobre el calendario.
  diasEjecutados Int

  motivo         MotivoInterrupcionEP
  motivoDetalle  String?
  // Certificado de práctica parcial emitido por la empresa/entidad — requisito explícito de
  // §9.3.1 para poder contabilizar el tiempo ya ejecutado.
  certificadoUrl String?

  estado            EstadoEvidencia @default(PENDIENTE)
  avaladoPorId      String?
  avaladoPor        User?           @relation("AvalInterrupcionEP", fields: [avaladoPorId], references: [id], onDelete: SetNull)
  fechaAval         DateTime?
  observacionesAval String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SeleccionAlternativaGrupo {
  id     String @id @default(cuid())
  fichaId String
  ficha   Ficha  @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  creadoPorId String
  creadoPor   User   @relation("SeleccionesGrupoCreadas", fields: [creadoPorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  selecciones SeleccionAlternativaEP[]
}

// Evidencia (b): Formalización de la Etapa Productiva — documento certificador (carta de
// vínculo laboral, contrato laboral, carta de pasantía u otro), previo a la fecha de inicio de
// la Etapa Productiva. Una vigente por aprendiz.
model FormalizacionEtapaProductiva {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("AprendizFormalizacion", fields: [userId], references: [id], onDelete: Cascade)

  // Tipo de documento certificador (carta de vínculo laboral, contrato laboral, carta de
  // pasantía, u otro) — texto corto, el formato no cierra esta lista a valores fijos.
  tipoDocumento String
  archivoUrl    String
  fecha         DateTime

  estado            EstadoEvidencia @default(PENDIENTE)
  avaladoPorId      String?
  avaladoPor        User?           @relation("AvalFormalizacion", fields: [avaladoPorId], references: [id], onDelete: SetNull)
  fechaAval         DateTime?
  observaciones     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Primer micro proceso de la etapa productiva: concertación de funciones (= Momento 1 —
// Planeación, formato GFPI-F-023). Cada aprendiz agenda una única fecha/franja; se valida que no
// choque con la de otro aprendiz. El formato oficial no trae una rúbrica para este momento, pero
// el instructor sí lo valora en la app (ver `variables`, `VariablePlaneacionEP`) — igual que los
// Momentos 2 y 3 — sobre la calidad de la planeación acordada, no sobre desempeño (aún no
// arranca la etapa productiva). El campo `calificacion` hereda de Fase 0 (A/D/P) y no se usa aquí.
model ConcertacionFuncion {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fecha      DateTime // Fecha de la cita (solo la parte de fecha es relevante)
  horaInicio String // Hora de inicio de la franja, formato "HH:mm"
  horaFin    String // Hora de fin de la franja, formato "HH:mm"

  videollamadaUrl String? // Enlace real de la videollamada (Google Meet, o Jitsi si no hay integración con Google Calendar)
  googleEventId   String? // Id del evento en Google Calendar, para poder actualizarlo al reagendar

  // Contenido real del Momento 1 (planeación), según GFPI-F-023.
  competenciasDesarrollar   String?
  resultadosAprendizaje     String?
  actividadesDesarrollar    String?
  evidenciasAprendizaje     String?
  observacionesAdicionales  String?
  arlFechaAfiliacion        DateTime?
  arlNumeroPoliza           String?
  horario                   String?
  enlaceGrabacion           String?

  // Calificación institucional A/D/P — Fase 0, sin uso real (el Momento 1 del formato oficial no
  // lleva calificación). Se conserva el campo por si se necesita un resumen calculado más adelante.
  calificacion  Calificacion?
  observaciones String? // Observaciones del instructor al calificar

  // Valoración del instructor sobre la planeación acordada (aval), independiente de `calificacion`.
  estado       EstadoEvidencia @default(PENDIENTE)
  avaladoPorId String?
  avaladoPor   User?           @relation("AvalConcertacion", fields: [avaladoPorId], references: [id], onDelete: SetNull)
  fechaAval    DateTime?
  variables    ConcertacionVariable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
}

// Una fila por cada una de las 6 variables de la valoración del Momento 1 (Concertación), para el
// aval del instructor — mismo patrón que `EvaluacionVariable`, ver `VariablePlaneacionEP`.
model ConcertacionVariable {
  id             String              @id @default(cuid())
  concertacionId String
  concertacion   ConcertacionFuncion @relation(fields: [concertacionId], references: [id], onDelete: Cascade)

  variable      VariablePlaneacionEP
  valoracion    ValoracionVariable?
  observaciones String?

  @@unique([concertacionId, variable])
}

// Momentos 2 y 3 (Seguimiento y Evaluación final, formato GFPI-F-023), más los seguimientos
// extraordinarios a petición del coformador o del aprendiz. Cada uno trae su propia rúbrica de
// 13 variables (`EvaluacionVariable`); el juicio final Aprobado/No aprobado y las
// retroalimentaciones de cierre solo aplican al Momento 3 (numero = 3).
model Evaluacion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 2 = Momento de seguimiento a los ~2 meses; 3 = Momento de evaluación de cierre (10-15 días
  // antes de terminar). Los seguimientos extraordinarios no llevan numero fijo — ver esExtraordinario.
  numero Int

  esExtraordinario      Boolean @default(false)
  motivoExtraordinario  String?

  fecha      DateTime?
  horaInicio String?
  horaFin    String?

  videollamadaUrl String?
  googleEventId   String?
  modalidad       ModalidadEjecucionEP?
  enlaceGrabacion String?

  // Solo se diligencia en el Momento 3 (cierre).
  juicioFinal                 JuicioEtapaProductiva?
  retroalimentacionCoformador String?
  retroalimentacionInstructor String?
  retroalimentacionAprendiz   String?

  // Calificación A/D/P — Fase 0, sin uso real (ver rúbrica real en `EvaluacionVariable`).
  calificacion  Calificacion?
  observaciones String?

  estado            EstadoEvidencia @default(PENDIENTE)
  avaladoPorId      String?
  avaladoPor        User?           @relation("AvalEvaluacion", fields: [avaladoPorId], references: [id], onDelete: SetNull)
  fechaAval         DateTime?

  variables EvaluacionVariable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([userId, numero])
}

// Una fila por cada una de las 13 variables de la rúbrica GFPI-F-023, para un Momento
// (Evaluacion) dado — 8 técnicas + 5 actitudinales.
model EvaluacionVariable {
  id           String @id @default(cuid())
  evaluacionId String
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)

  categoria     CategoriaVariableEvaluacion
  variable      VariableEvaluacion
  valoracion    ValoracionVariable?
  observaciones String?

  @@unique([evaluacionId, variable])
}

// Bitácora quincenal (formato institucional GFPI-F-147). ~12 por aprendiz durante los 6 meses.
model Bitacora {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  numero       Int // Secuencia 1-12
  periodoDesde DateTime?
  periodoHasta DateTime?
  fechaLimite  DateTime // Calculada desde User.fechaInicioEtapaProductiva + 15 días * numero
  fechaEntrega DateTime?
  archivoUrl   String? // Plantilla diligenciada subida por el aprendiz (o generada con firma en la app)

  // Información de afiliación a la ARL — se re-pregunta en cada bitácora porque puede cambiar.
  arlAfiliado          Boolean?
  arlNivelRiesgo       NivelRiesgoARL?
  arlRiesgoCorresponde Boolean?
  arlTieneEPP          Boolean?

  estado        EstadoEvidencia @default(PENDIENTE)
  observaciones String?
  avaladoPorId  String?
  avaladoPor    User?           @relation("AvalBitacora", fields: [avaladoPorId], references: [id], onDelete: SetNull)
  fechaAval     DateTime?

  actividades BitacoraActividad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, numero])
  @@index([fechaLimite])
}

// Fila de la tabla "Descripción de las actividades realizadas" de la bitácora — se pueden
// agregar cuantas filas sean necesarias.
model BitacoraActividad {
  id         String @id @default(cuid())
  bitacoraId String
  bitacora   Bitacora @relation(fields: [bitacoraId], references: [id], onDelete: Cascade)

  descripcion            String
  competencias           String?
  fechaInicio            DateTime?
  fechaFin               DateTime?
  evidenciaCumplimiento  String?
  observaciones          String?
}

// Evidencia de cierre: carta de terminación del contrato de aprendizaje a satisfacción de la
// empresa. Requisito para poder emitir la Evaluación 3 (evaluación final). Se sube en una
// ventana de 5 días antes o 5 días después de `User.fechaFinEtapaProductiva` (validado en el
// endpoint, no aquí).
model CertificacionEmpresario {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  archivoUrl String?
  fecha      DateTime?
  estado     EstadoEvidencia @default(PENDIENTE)

  avaladoPorId  String?
  avaladoPor    User?     @relation("AvalCertificacion", fields: [avaladoPorId], references: [id], onDelete: SetNull)
  fechaAval     DateTime?
  observaciones String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Token de un solo uso para el flujo de "olvidé mi contraseña". El usuario se identifica con su
// cédula (dato de ingreso principal), pero el enlace de recuperación se envía al correo que tiene
// registrado — es el único canal que tenemos para confirmar que quien pide el cambio es el dueño
// de la cuenta. Expira a la hora de generado y solo puede usarse una vez (usedAt).
model PasswordResetToken {
  id     String @id @default(cuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// Tipo de aviso de plazo enviado por correo (ver src/app/api/cron/avisos-plazo).
enum TipoAvisoPlazo {
  // Faltan pocos días (o vence hoy).
  PROXIMO
  // La fecha límite pasó sin que el aprendiz entregara.
  VENCIDO
}

// Registro histórico de los avisos de plazo enviados por correo: requisitos §3.3 ("llevar un
// registro histórico por aprendiz") y §5 (entidad Notificación). Sirve además para no repetir:
// cada entrega recibe como máximo un aviso PROXIMO y uno VENCIDO. La fecha límite forma parte de
// la clave, así que si cambia (retoma tras interrumpir, reanudación de un aplazamiento) la entrega
// con su fecha nueva vuelve a poder avisarse.
model AvisoPlazo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("AvisosPlazo", fields: [userId], references: [id], onDelete: Cascade)

  // Qué entrega: "concertacion", "bitacora:7", "momento:2", "momento:3".
  clave       String
  tipo        TipoAvisoPlazo
  fechaLimite DateTime

  // Correos a los que efectivamente se envió, separados por coma.
  destinatarios String
  enviadoEn     DateTime @default(now())

  @@unique([userId, clave, tipo, fechaLimite])
  @@index([userId])
}
